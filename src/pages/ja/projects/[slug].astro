---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getEntry } from "astro:content";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import ProjectDetailShared from "@/modules/ProjectDetailShared.astro";
import { getProjects } from "@/lib/projects";
import { useTranslations } from "@/i18n/utils";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return Promise.all(
    projects.map(async (project) => ({
      params: { slug: project.id },
      props: {
        project,
        details: await getEntry("projectDetails", `ja/${project.id}`),
      },
    })),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, details } = Astro.props;
const t = useTranslations("ja");
---

<ProjectLayout
  title={t(project.data.titleKey)}
  description={t(project.data.shortDescriptionKey)}>
  <div
    class="w-container mx-auto flex max-w-full flex-col items-center gap-4 py-8 text-left text-foreground">
    <ProjectDetailShared project={project} details={details} />
  </div>
</ProjectLayout>
