---
import type { GetStaticPaths } from "astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getProjects } from "@/lib/projects";
import { locales } from "@/i18n/ui";
import { getLang, useTranslations } from "@/i18n/utils";

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const projects = await getProjects();
---

<ProjectLayout
  title={t("index.projects.all_title")}
  description={t("index.projects.all_description")}>
  <div class="mx-auto flex w-full max-w-screen-lg flex-col gap-8 px-4 py-8">
    <h1 class="text-2xl font-heading xl:text-4xl 2xl:text-5xl">
      {t("index.projects.all_title")}
    </h1>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</ProjectLayout>
