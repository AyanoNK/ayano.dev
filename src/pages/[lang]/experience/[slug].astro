---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ExternalLink, SquareArrowUpRightExit } from "@lucide/astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import Anchor from "@/components/Anchor.astro";
import Badge from "@/components/Badge.astro";
import MarkdownContent from "@/components/MarkdownContent.astro";
import { locales } from "@/i18n/ui";
import { getLang, useTranslations } from "@/i18n/utils";
import { getExperienceData } from "@/lib/experience/data";

export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    locales.map(async (lang) => {
      const { groups } = await getExperienceData(lang);
      return groups.flatMap(({ company, experiences }) =>
        experiences.map((experience) => ({
          params: { lang, slug: experience.id },
          props: { company, experience },
        })),
      );
    }),
  );
  return paths.flat();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { company, experience } = Astro.props;
const { meta, detail, dates, role } = experience;
const { title, client, summary, highlights } = detail.data;
const { Content } = await render(detail);
---

<ProjectLayout
  title={title}
  description={summary}
  backHref={getRelativeLocaleUrl(lang, "experience")}
  backLabel={t("index.experience.back_to_list")}>
  <div class="mx-auto flex w-full max-w-screen-lg flex-col gap-8 px-4 py-8">
    <div class="flex flex-col gap-4">
      <h1 class="text-2xl font-heading xl:text-4xl 2xl:text-5xl">{title}</h1>
      <div class="flex flex-col gap-1">
        <p class="text-lg font-semibold">{client}</p>
        <p class="text-sm">
          <a
            class="inline-flex items-start gap-1 font-heading underline"
            href={company.url}
            target="_blank">
            {company.name}
            <ExternalLink size="0.875rem" />
          </a>
          {" · "}
          {role.title[lang]} · {dates}
          {company.location && ` · ${company.location[lang]}`}
        </p>
      </div>
      {meta.technologies.length > 0 && (
        <div class="flex flex-col gap-2">
          <h2 class="text-sm font-semibold">
            {t("index.experience.technologies")}
          </h2>
          <div class="flex flex-row flex-wrap gap-2">
            {meta.technologies.map((tech) => (
              <Badge class="text-md">{tech}</Badge>
            ))}
          </div>
        </div>
      )}
    </div>

    <section class="flex flex-col gap-3 rounded-base border-2 border-border bg-main p-6 text-main-foreground shadow-shadow sm:p-8">
      <h2 class="text-xl font-heading">{t("index.experience.highlights")}</h2>
      <ul class="flex list-disc flex-col gap-2 pl-6">
        {highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    </section>

    <MarkdownContent>
      <Content />
    </MarkdownContent>

    {meta.links.length > 0 && (
      <div class="flex flex-col gap-4">
        <h2 class="text-xl font-heading">{t("index.experience.links")}</h2>
        <div class="flex flex-wrap gap-4">
          {meta.links.map((link) => (
            <Anchor variant="neutral" href={link.url} size="lg" target="_blank">
              <SquareArrowUpRightExit />
              {link.title[lang]}
            </Anchor>
          ))}
        </div>
      </div>
    )}
  </div>
</ProjectLayout>
