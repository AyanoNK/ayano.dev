---
import type { GetStaticPaths } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ExternalLink } from "@lucide/astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import Anchor from "@/components/Anchor.astro";
import { locales } from "@/i18n/ui";
import { getLang, useTranslations } from "@/i18n/utils";
import { getExperienceData } from "@/lib/experience/data";
import { formatRange } from "@/lib/experience/dates";

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { groups } = await getExperienceData(lang);
const present = t("index.experience.present");
---

<ProjectLayout
  title={t("index.experience.all_title")}
  description={t("index.experience.all_description")}>
  <div class="mx-auto flex w-full max-w-screen-lg flex-col gap-12 px-4 py-8">
    <h1 class="text-2xl font-heading xl:text-4xl 2xl:text-5xl">
      {t("index.experience.all_title")}
    </h1>
    {groups.map(({ company, experiences }) => (
      <section class="flex flex-col gap-6">
        <div class="flex flex-col gap-3 rounded-base border-2 border-border bg-main p-4 text-main-foreground shadow-shadow sm:p-6">
          <a
            class="flex flex-row items-start gap-1 text-xl font-heading"
            href={company.url}
            target="_blank">
            {company.name}
            <ExternalLink size="1rem" />
          </a>
          {company.location && <p class="text-sm">{company.location[lang]}</p>}
          <ul class="flex flex-col gap-1 text-sm font-semibold">
            {company.roles.map((role) => (
              <li>
                {role.title[lang]} ·{" "}
                {formatRange(role.start, role.end, lang, present)}
              </li>
            ))}
          </ul>
          <p class="text-sm">{company.summary[lang]}</p>
        </div>
        <ul class="flex flex-col gap-4">
          {experiences.map(({ section, detail }) => (
            <li>
              <a
                class="group flex flex-col gap-1 rounded-base border-2 border-border bg-white p-4 shadow-shadow transition-all hover:translate-x-boxShadowX hover:translate-y-boxShadowY hover:shadow-none"
                href={`${getRelativeLocaleUrl(lang, `experience/${company.id}`)}#${section}`}>
                <span class="font-heading">{detail.data.title}</span>
                <span class="text-sm font-semibold">{detail.data.client}</span>
                <span class="text-sm">{detail.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
        <div>
          <Anchor
            variant="neutral"
            href={getRelativeLocaleUrl(lang, `experience/${company.id}`)}>
            {t("index.experience.view_details")} &rarr;
          </Anchor>
        </div>
      </section>
    ))}
  </div>
</ProjectLayout>
