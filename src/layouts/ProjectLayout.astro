---
import BaseLayout from "./BaseLayout.astro";
import LanguageSelector from "@/modules/LanguageSelector.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { Anchor } from "@/components/ui/anchor";
import { ArrowLeft } from "lucide-react";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={`${title} | Sebastian Correa`} description={description}>
  <div class="fixed top-4 right-4 z-50">
    <LanguageSelector />
  </div>
  <nav class="p-4 sm:p-8">
    <Anchor variant="neutral" href={`/${lang}/`} size="default">
      <ArrowLeft size={16} />
      {t("index.projects.back")}
    </Anchor>
  </nav>
  <slot />
</BaseLayout>
