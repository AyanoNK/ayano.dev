---
import type { CvEntry as Entry } from "@/data/cv";
import { formatCvRange } from "@/lib/cv/format";
import CvMeta from "./CvMeta.astro";
import InlineLinks from "./InlineLinks.astro";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
---

<article class="cv-item">
  <h3 class="text-[14.3px] leading-[19px] font-medium">{entry.title}</h3>
  <CvMeta icon="calendar">{formatCvRange(entry.start, entry.end)}</CvMeta>
  {entry.location && (
    <CvMeta icon="pin">
      <span>{entry.location}</span>
      <span class="ml-auto pr-[20px] whitespace-nowrap">{entry.tech}</span>
    </CvMeta>
  )}
  <CvMeta icon="link">
    <a href={entry.link}>{entry.company ?? entry.link}</a>
  </CvMeta>
  <p class="mt-[4px]">{entry.description}</p>
  {entry.bullets.length > 0 && (
    <ul class="mt-[2px] list-disc pl-[13px]">
      {entry.bullets.map((bullet) => (
        <li>
          <InlineLinks text={bullet} />
        </li>
      ))}
    </ul>
  )}
</article>
