---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="cv-section mb-[14px]">
  <h2 class="mb-[4px] border-b-[3px] border-black pb-[1px] font-[family-name:var(--font-raleway)] text-[18px] leading-tight font-bold uppercase">
    {title}
  </h2>
  <slot />
</section>
