---
import type { CvReference as Reference } from "@/data/cv";

interface Props {
  reference: Reference;
}

const { reference } = Astro.props;
---

<div class="cv-item">
  <h3 class="text-[13px] leading-[18px] font-bold">{reference.name}</h3>
  <p class="mt-[3px]">{reference.role}</p>
  <a href={`mailto:${reference.email}`} class="block underline">
    {reference.email}
  </a>
  {reference.phone && (
    <a href={`tel:${reference.phone.replace(/[^+\d]/g, "")}`} class="block">
      {reference.phone}
    </a>
  )}
</div>
