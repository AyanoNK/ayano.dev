---
import type { CvEducation as Education } from "@/data/cv";
import { formatCvRange } from "@/lib/cv/format";
import CvMeta from "./CvMeta.astro";

interface Props {
  education: Education;
}

const { education } = Astro.props;
---

<div class="cv-item flex">
  <div class="flex-1">
    <h3 class="text-[14.3px] leading-[19px] font-medium">{education.degree}</h3>
    <p class="text-[12.6px] leading-[17px] font-bold text-[#880808]">
      {education.institution}
    </p>
    <CvMeta icon="calendar">
      {formatCvRange(education.start, education.end)}
    </CvMeta>
    <CvMeta icon="pin">{education.location}</CvMeta>
  </div>
  <div class="my-[4px] flex w-[60px] flex-col items-center border-l border-[#ccc] pt-[2px]">
    <span class="text-[9px] text-[#666]">GPA</span>
    <span class="mt-[6px] text-[12.5px]">
      <b class="text-[#880808]">{education.gpa}</b>{" "}
      <span class="text-[#666]">/ {education.maxGpa}</span>
    </span>
  </div>
</div>
