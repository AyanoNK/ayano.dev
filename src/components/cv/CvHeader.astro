---
import AtSign from "@lucide/astro/icons/at-sign";
import Link from "@lucide/astro/icons/link";
import MapPin from "@lucide/astro/icons/map-pin";
import type { Cv } from "@/data/cv";

interface Props {
  cv: Cv;
}

const { cv } = Astro.props;
const { contact } = cv;
const items = [
  { icon: AtSign, text: contact.email, href: `mailto:${contact.email}` },
  { icon: Link, text: contact.site, href: `https://${contact.site}` },
  { icon: Link, text: contact.linkedin, href: `https://${contact.linkedin}` },
  { icon: MapPin, text: contact.location },
];
---

{/* The site's square grid behind the header, fading to white before the body text. It is a plain background, not a positioned layer, so the header text stays first in the PDF. */}
<header class="-mx-[33px] -mt-[30px] bg-[linear-gradient(to_bottom,transparent_54%,white),linear-gradient(to_right,#80808033_1px,transparent_1px),linear-gradient(to_bottom,#80808033_1px,transparent_1px)] bg-[size:100%_100%,30px_30px,30px_30px] px-[33px] pt-[30px] pb-[14px]">
  <h1 class="text-[32.2px] leading-[36px] font-bold uppercase">{cv.name}</h1>
  <p class="text-[17px] leading-[22px] font-bold text-darkpurple">{cv.title}</p>
  <ul class="mt-[6px] flex flex-wrap gap-x-[14px] text-[11px] font-bold text-[#333]">
    {items.map(({ icon: Icon, text, href }) => (
      <li class="flex items-center gap-[4px]">
        <Icon class="size-[11px] text-darkpurple" stroke-width={2.5} />
        {href ? <a href={href}>{text}</a> : text}
      </li>
    ))}
  </ul>
</header>
