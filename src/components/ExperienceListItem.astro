---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations } from "@/i18n/utils";
import type { ExperienceItem } from "@/lib/experience/data";

interface Props {
  experience: ExperienceItem;
}

const { experience } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, client, summary } = experience.detail.data;
---

<a
  href={getRelativeLocaleUrl(lang, `experience/${experience.id}`)}
  class="block w-full overflow-hidden rounded-base border-2 border-border bg-white shadow-shadow transition-all hover:translate-x-boxShadowX hover:translate-y-boxShadowY hover:shadow-none">
  <div class="flex flex-col gap-3 p-4 sm:p-6">
    <div class="flex flex-col gap-1">
      <h3 class="text-lg font-heading">{title}</h3>
      <p class="text-sm font-semibold">{client}</p>
      <p class="text-sm text-foreground/70">
        {experience.role.title[lang]} · {experience.dates}
      </p>
    </div>
    <p class="text-sm">{summary}</p>
    <span class="text-sm font-base text-foreground/60">
      {t("index.experience.view_details")} &rarr;
    </span>
  </div>
</a>
