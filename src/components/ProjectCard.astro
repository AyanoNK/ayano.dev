---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";
import { getLang, useTranslations } from "@/i18n/utils";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import Anchor from "@/components/Anchor.astro";
import TechnologyChips from "@/components/TechnologyChips.astro";
import ShowcaseMedia from "@/components/ShowcaseMedia.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, description } = project.data.text[lang];
---

<div class="h-full w-full">
  <Card className="h-full w-full bg-white">
    <CardHeader>
      <div class="flex flex-col gap-4">
        {project.data.highlightMedia && (
          <ShowcaseMedia
            media={project.data.highlightMedia}
            alt={title}
            class="aspect-video w-full rounded-base object-contain"
          />
        )}
        <CardTitle>{title}</CardTitle>
      </div>
    </CardHeader>
    <CardContent className="flex flex-1 flex-col">
      <CardDescription>{description}</CardDescription>
    </CardContent>
    <CardFooter className="flex flex-col items-start gap-8">
      <TechnologyChips technologies={project.data.technologies} />
      <Anchor
        variant="neutral"
        href={getRelativeLocaleUrl(lang, `projects/${project.id}`)}>
        {t("index.projects.view_details")} &rarr;
      </Anchor>
    </CardFooter>
  </Card>
</div>
