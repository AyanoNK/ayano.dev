---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import { getLang, useTranslations } from "@/i18n/utils";
import { Badge } from "@/components/ui/badge";
import { Anchor } from "@/components/ui/anchor";
import { Github, SquareArrowOutUpRight } from "lucide-react";

interface Props {
  project: CollectionEntry<"projects">;
  details?: CollectionEntry<"projectDetails">;
}

const { project, details } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const title = t(project.data.titleKey);
const Content = details ? (await render(details)).Content : undefined;
---

<div class="mx-auto flex w-full max-w-screen-lg flex-col gap-8 px-4 py-8">
  <!-- Representative image -->
  {
    project.data.image && (
      <div class="overflow-hidden rounded-base border-2 border-border shadow-shadow">
        <Image
          src={project.data.image}
          alt={title}
          priority
          class="w-full object-cover"
        />
      </div>
    )
  }

  <!-- Title -->
  <div class="flex flex-col gap-4">
    <h1 class="text-2xl font-heading xl:text-4xl 2xl:text-5xl">
      {title}
    </h1>

    <!-- Long description (rendered Markdown) -->
    <!-- Technologies -->
    <div class="flex flex-row flex-wrap gap-2">
      {
        project.data.technologies.map((tech) => (
          <Badge className="text-md">{tech}</Badge>
        ))
      }
    </div>
  </div>
  {
    Content && (
      <div class="markdown-content max-w-none rounded-base border-2 border-border bg-white p-6 shadow-shadow sm:p-8">
        <Content />
      </div>
    )
  }
  <!-- Links -->
  <div class="flex flex-wrap gap-4">
    {
      project.data.additionalLinks.map((link) => (
        <Anchor
          variant="neutral"
          href={link.url}
          size="lg"
          target="_blank"
          aria-label={link.title}>
          {link.icon === "github" ? <Github /> : <SquareArrowOutUpRight />}
          {link.title}
        </Anchor>
      ))
    }
  </div>
  <!-- Video/Demo (if exists) -->
  {
    project.data.video && (
      <div>
        <h2 class="mb-4 text-xl font-heading">{t("index.projects.demo")}</h2>
        <div class="flex justify-center">
          <video
            width={project.data.video.width}
            height={project.data.video.height}
            autoplay
            muted
            loop
            class="rounded-3xl border-2 border-border shadow-shadow">
            <source
              src={`/webm/${project.data.video.id}.webm`}
              type="video/webm"
            />
          </video>
        </div>
      </div>
    )
  }
</div>

<style>
  .markdown-content :global(h1) {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .markdown-content :global(h2) {
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .markdown-content :global(h3) {
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .markdown-content :global(p) {
    margin-bottom: 0.75rem;
    line-height: 1.7;
  }
  .markdown-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .markdown-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .markdown-content :global(li) {
    margin-bottom: 0.35rem;
    line-height: 1.7;
  }
  .markdown-content :global(strong) {
    font-weight: 700;
  }
  .markdown-content :global(> *:first-child) {
    margin-top: 0;
  }
</style>
