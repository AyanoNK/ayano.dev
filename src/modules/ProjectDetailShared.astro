---
import { render, type CollectionEntry } from "astro:content";
import { getLang, useTranslations } from "@/i18n/utils";
import Badge from "@/components/Badge.astro";
import Anchor from "@/components/Anchor.astro";
import Carousel from "@/components/Carousel.astro";
import ShowcaseMedia from "@/components/ShowcaseMedia.astro";
import MarkdownContent from "@/components/MarkdownContent.astro";
import { SquareArrowUpRightExit } from "@lucide/astro";
import { GithubIcon } from "@/lib/brandIcons";

interface Props {
  project: CollectionEntry<"projects">;
  details?: CollectionEntry<"projectDetails">;
}

const { project, details } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title } = project.data.text[lang];
const Content = details ? (await render(details)).Content : undefined;
const links = [
  ...(project.data.isPrivate
    ? []
    : [{ title: "GitHub", url: project.data.url, icon: "github" }]),
  ...project.data.links.map((link) => ({ ...link, icon: "external" })),
];
---

<div class="mx-auto flex w-full max-w-screen-lg flex-col gap-8 px-4 py-8">
  <!-- Representative image -->
  {project.data.cover && (
    <div class="overflow-hidden rounded-base border-2 border-border shadow-shadow">
      <ShowcaseMedia
        media={project.data.cover}
        alt={title}
        priority
        class="w-full object-cover"
      />
    </div>
  )}

  <!-- Title -->
  <div class="flex flex-col gap-4">
    <h1 class="text-2xl font-heading xl:text-4xl 2xl:text-5xl">{title}</h1>

    <!-- Technologies -->
    <div class="flex flex-row flex-wrap gap-2">
      {project.data.technologies.map((tech) => (
        <Badge class="text-md">{tech}</Badge>
      ))}
    </div>
  </div>
  {Content && (
    <MarkdownContent>
      <Content />
    </MarkdownContent>
  )}
  <!-- Links -->
  {links.length > 0 && (
    <div class="flex flex-wrap gap-4">
      {links.map((link) => (
        <Anchor
          variant="neutral"
          href={link.url}
          size="lg"
          target="_blank"
          aria-label={link.title}>
          {link.icon === "github" ? <GithubIcon /> : <SquareArrowUpRightExit />}
          {link.title}
        </Anchor>
      ))}
    </div>
  )}
  <!-- Gallery -->
  {project.data.carousel.length > 0 && (
    <div>
      <h2 class="mb-4 text-xl font-heading">{t("index.projects.gallery")}</h2>
      <Carousel items={project.data.carousel} alt={title} />
    </div>
  )}
</div>
